# Copy this file to credentials.env, fill in your credentials, and load it into your session
# before running the sample:
#
#   cp credentials.env.sample credentials.env
#   source credentials.env
#   java -jar target/Web-Viewer-JavaSamples.jar -o 1 -b <server HTTPS address and port>
#
# Git ignores credentials.env so your credentials are not committed.

export WV_USERNAME=
export WV_PASSWORD=
