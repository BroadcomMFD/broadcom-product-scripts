# Copy this file to credentials.env.ps1, fill in your credentials, and load it into your session
# before running the sample:
#
#   Copy-Item credentials.env.ps1.sample credentials.env.ps1
#   . .\credentials.env.ps1
#   java -jar target/Web-Viewer-JavaSamples.jar -o 1 -b <server HTTPS address and port>
#
# Git ignores credentials.env.ps1 so your credentials are not committed.

$env:WV_USERNAME = ""
$env:WV_PASSWORD = ""
