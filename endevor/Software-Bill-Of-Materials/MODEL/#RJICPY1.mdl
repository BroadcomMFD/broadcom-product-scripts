@TRACEON                                                                        
@REM ****************************************************** #RJICPY1 ***        
@REM *    CONTENTS: ENDEVOR/MVS - START PROCESSING A NEW DESTINATION            
@REM *              REMOTE JOBSTREAM TO COPY/DELETE SHIPMENT MEMBERS            
@REM *     PURPOSE: GENERATE A REMOTE JOBSTREAM TO CREATE/DELETE                
@REM *              SHIPMENT MEMBERS USING IBM UTILITIES AND CONFIRM            
@REM *              THE EXECUTION OF THIS JOBSTREAM AT THE HOST                 
@REM *******************************************************************        
@REM *                                                                          
@REM *     P003154 APPLIED     REMOVE //* IN SECTION05                          
@REM *     P005812 ADDED INCLUDE OF #RJICPYU TO CONTAIN SYSUT3, SYSUT4          
@REM *                                                                          
@SECTION=01   <=======================================================          
&RJOBCARDS                                                                      
//*#####################################################################        
//*                                                                             
//* SYMBOLS DEFINITION                                                          
//*                                                                             
//*#####################################################################        
//E1       EXPORT SYMLIST=(*)                                                   
//S1       SET DATE=&LYYMMDD                                                    
//S2       SET TIME=&LHHMMSS                                                    
//S3       SET USER=&SYSUID                                                     
//S4       SET PKGID='@@PKGID@@'                                                
@IF &RUCD                                                                       
//*#####################################################################        
//*                                                                             
//* Temporarily expand pax file to get USS elements for HASH validatio          
//*                                                                             
//*#####################################################################        
//XPANDPAX EXEC PGM=BPXBATCH,COND=(0,NE)                                        
//STDOUT   DD   SYSOUT=*                                                        
//STDERR   DD   SYSOUT=*                                                        
//STDPARM  DD *,SYMBOLS=JCLONLY                                                 
SH                                                                              
  cp "//'&RUCD'"                                                                
     /tmp/&USER._D&DATE._T&TIME..&PKGID._ARPAX.txt ;                            
  paxcmd=$(cat /tmp/&USER._D&DATE._T&TIME..&PKGID._ARPAX.txt |                  
         grep "ARPAX");                                                         
  new_paxcmd=$(echo "$paxcmd" | sed 's/-rvzk/-rvz/');                           
  eval "$new_paxcmd";                                                           
@ENDIF                                                                          
//*#####################################################################        
//*                                                                             
//* Copy mapping json structure from MVS to USS File                            
//*                                                                             
//*#####################################################################        
//CNVASCII EXEC PGM=IKJEFT01,DYNAMNBR=300,COND=(0,LT)         C1BMXCOP          
//RMAPOUT  DD PATH='/tmp/&USER_D&DATE_T&TIME..&PKGID._shiprmap.json',           
//            PATHOPTS=(OWRONLY,OCREAT,OTRUNC),                                 
//            PATHMODE=SIRWXU,FILEDATA=TEXT                                     
//SYSTSPRT DD SYSOUT=*                                                          
//SYSPRINT DD SYSOUT=*                                                          
//SYSTSIN  DD *                                                                 
OCOPY INDD(SHIPRMAP) OUTDD(RMAPOUT)                                             
//SHIPRMAP DD   *                                                               
//*#####################################################################        
//*                                                                             
//* SBOM HASH Validation using remap json file and public signature             
//*                                                                             
//*#####################################################################        
//HASHVRFY EXEC PGM=BPXBATCH,REGION=0M,COND=(0,LT)            C1BMXCOP          
//STDIN    DD DUMMY                                                             
//STDOUT   DD PATHOPTS=(OWRONLY,OCREAT,OTRUNC),                                 
// PATH='/tmp/&USER_D&DATE_T&TIME..&PKGID._hashvrfy.out',                       
// PATHMODE=SIRWXU                                                              
//STDERR   DD PATHOPTS=(OWRONLY,OCREAT,OTRUNC),                                 
// PATH='/tmp/&USER_D&DATE_T&TIME..&PKGID._hashvrfy.err',                       
// PATHMODE=SIRWXU                                                              
//STDENV   DD DUMMY                                                             
//STDPARM  DD *,SYMBOLS=JCLONLY                                                 
sh                                                                              
 cd $SBOMZ_HOME ;                                                               
 awk '                                                                          
 {                                                                              
   gsub(/[ \t\r]+$/, "");                                                       
   if (buf == "") {                                                             
       buf = $0                                                                 
   } else {                                                                     
       sub(/^[ \t]+/, "", $0);                                                  
   buf = buf $0                                                                 
   };                                                                           
                                                                                
   q = buf;                                                                     
   gsub(/[^"]/, "", q);                                                         
                                                                                
   if (length(q) % 2 == 0) {                                                    
       gsub(/[ \t]*:[ \t]*/, ": ", buf);                                        
       gsub(/[ \t]*,[ \t]*/, ", ", buf);                                        
       print buf; buf = ""                                                      
   }                                                                            
 }                                                                              
 ' /tmp/&USER._D&DATE._T&TIME..&PKGID._shiprmap.json >                          
   /tmp/&USER._D&DATE._T&TIME..&PKGID._shiprmap_format.json ;                   
                                                                                
 iconv -f IBM-1047 -t UTF-8                                                     
      /tmp/&USER._D&DATE._T&TIME..&PKGID._shiprmap_format.json >                
      /tmp/&USER._D&DATE._T&TIME..&PKGID._shiprmap_ascii.json;                  
                                                                                
 chtag -t -c ISO8859-1                                                          
     /tmp/&USER._D&DATE._T&TIME..&PKGID._shiprmap_ascii.json;                   
                                                                                
 sbomz validate                                                                 
   @@signedSBOMfile@@                                                           
 --mapping-config                                                               
   /tmp/&USER._D&DATE._T&TIME..&PKGID._shiprmap_ascii.json                      
 --key-path-public                                                              
   $SBOMZ_HOME/ship_sbom_pub.key                                                
 --config-work-directory $SBOMZ_HOME ;                                          
//*#####################################################################        
//*                                                                             
//* Verify if Remote Staging Data Sets have been tampered with                  
//*                                                                             
//*#####################################################################        
//RSDSVRFY EXEC PGM=IKJEFT01,COND=(0,NE),REGION=0M         C1BMXCOP             
//SYSTSPRT DD SYSOUT=*                                                          
//SYSPRINT DD SYSOUT=*                                                          
//SHIPRMAP DD PATHMODE=SIRWXU,FILEDATA=TEXT,                                    
// PATH='/tmp/&USER_D&DATE_T&TIME..&PKGID._shiprmap_format.json'                
//SYSEXEC  DD UNIT=SYSDA,SPACE=(CYL,(5,1,5)),                                   
// DSN=&SYSEXEC,                                                                
// RECFM=FB,LRECL=80,BLKSIZE=0,DSORG=PO                                         
//SYSUT2   DD DISP=(OLD,PASS),VOL=REF=*.SYSEXEC,                                
// DSN=&SYSEXEC(RSDSVRFY)                                                       
//SYSTSIN  DD *                                                                 
REPRO IFILE(REXXMOD) OFILE(SYSUT2)                                              
RSDSVRFY                                                                        
/*                                                                              
//REXXMOD  DD *,DLM='@@'                                                        
/* REXX */                                                                      
if \ExistDDname('SHIPRMAP') Then Do                                             
  say 'RSDSVRFY01E DDname SHIPRMAP is not allocated.'                           
  Return 8                                                                      
End                                                                             
                                                                                
"execio * diskr shiprmap (stem shiprmap. finis"                                 
                                                                                
if shiprmap.0 = 0 then do                                                       
  say 'RSDSVRFY02E SHIPRMAP file is empty'                                      
  return 8                                                                      
End                                                                             
                                                                                
/*                                                                              
  Build actual mapping table                                                    
*/                                                                              
RSDSList = ''                                                                   
RSDSx.= ''                                                                      
                                                                                
Do i=1 to shiprmap.0                                                            
                                                                                
 If shiprmap.i \= '{' & shiprmap.i \= '}' Then Do                               
                                                                                
   If pos(':',shiprmap.i) <> 0 then do                                          
                                                                                
     j = i + 1                                                                  
     RSDS = strip(shiprmap.j)                                                   
     parse var RSDS '"' RSDS '"' .                                              
                                                                                
     if substr(RSDS,1,1) = '/' then do                                          
       /* USS File */                                                           
       Element = substr(RSDS,LASTPOS('/',RSDS)+1,LENGTH(RSDS))                  
       Element = strip(Element)                                                 
       RSDS = substr(RSDS,1,LASTPOS('/',RSDS)-1)                                
       RSDSstem = Translate(substr(RSDS,2),'.','/')                             
       x = VALUE(value(RSDSstem).Element,1)                                     
      end                                                                       
     else do                                                                    
       /* MVS dataset */                                                        
       parse var RSDS RSDS "(" Element ")"                                      
        x = VALUE(value(RSDS).Element,1)                                        
      end                                                                       
                                                                                
     if pos(RSDS,RSDSList) = 0 then do                                          
       RSDSList = RSDSList || RSDS || ';'                                       
     end                                                                        
                                                                                
   End /* pos(':',shiprmap.i) <> 0 */                                           
                                                                                
 End /* shiprmap.i NOT IN '{,}' */                                              
                                                                                
End /* Do i */                                                                  
                                                                                
                                                                                
Loc = pos(';',RSDSList)                                                         
Do while Loc <> 0                                                               
  RemoteStagingDS = substr(RSDSList,1,Loc-1)                                    
  RSDSList = substr(RSDSList,Loc+1)                                             
  /*                                                                            
    Process every Remote Staging Data Set or PATH to validate if all            
    members or files are in the Transmission List sent by Endevor LPAR          
    files are in the Transmission List sent by Endevor LPAR                     
  */                                                                            
  select                                                                        
    when substr(RemoteStagingDS,1,1) = '/' then do                              
      /* USS Path */                                                            
      dirCmd = 'ls 'RemoteStagingDS                                             
      call bpxwunix dirCmd,,files.                                              
                                                                                
      do k=1 to files.0                                                         
                                                                                
        file = strip(files.k)                                                   
        RSDSstem = Translate(substr(RemoteStagingDS,2),'.','/')                 
        parse upper var RSDSstem RSDSstem .                                     
        if VALUE(value(RSDSstem).file) \= 1 then DO                             
          say 'RSDSVRFY04E Remote Staging PATH 'RemoteStagingDS ,               
                          'has been tampered with.'                             
          say '            File "'file'" was added to the Remote PATH after',   
                          'shipment'                                            
          say '            creation and before Endevor Shipment Remote JCL',    
                          'execution started.'                                  
          return 12                                                             
        end                                                                     
                                                                                
      end /* Do k=1 */                                                          
                                                                                
    end /* substr(RemoteStagingDS,1,1) = '/' */                                 
                                                                                
    otherwise                                                                   
      /* z/OS data set */                                                       
        x = outtrap(dirList.)                                                   
        address TSO "listds '"RemoteStagingDS"' members"                        
        x = outtrap(off)                                                        
                                                                                
        k = 1                                                                   
        do while pos('--MEMBERS--',dirList.k) = 0                               
        k = k + 1                                                               
        end                                                                     
                                                                                
        do k = k + 1 to dirList.0                                               
          member = strip(dirList.k)                                             
          if VALUE(value(RemoteStagingDS).member) \= 1 then DO                  
            say 'RSDSVRFY03E Remote Staging Data Set 'RemoteStagingDS ,         
                            'has been tampered with.'                           
            say '            Member "'member'" was added to the Remote',        
                            'dataset after shipment'                            
            say '            creation and before Endevor Shipment Remote JCL',  
                            'execution started.'                                
            return 12                                                           
          end                                                                   
        end /* K = 7 */                                                         
                                                                                
  end /* select RemoteStagingDS */                                              
                                                                                
  Loc = pos(';',RSDSList)                                                       
                                                                                
End /* Loc <> 0 */                                                              
                                                                                
return 0                                                                        
                                                                                
/*                                                                              
  Procedure ExistDDname allocated                                               
*/                                                                              
ExistDDname: Procedure                                                          
arg search4dd                                                                   
last1 = 0                                                                       
dsnlist = ''                                                                    
Found = 0                                                                       
Do i = 1 by 1 Until (last1 /= 0)                                                
   Call bpxwdyn 'info inrelno('i') inrtddn(found_dd)',                          
                'inrtlst(last1)'                                                
   If found_dd = search4dd Then                                                 
     Do                                                                         
       Found = 1                                                                
       leave                                                                    
     End                                                                        
End                                                                             
Return found                                                                    
@@                                                                              
@SECTION=02   <=======================================================          
@INCLUDE=(B)                                                                    
@IF &ANY2COPY                                                                   
//*#####################################################################        
//*                                                                             
//* COPY OF STAGING DATA SETS TO PRODUCTION DATA SETS                           
//*                                                                             
//*#####################################################################        
//JS01     EXEC PGM=IEBCOPY,COND=(0,NE)                    #RJICPY1             
//SYSPRINT DD   SYSOUT=*                                                        
@INCLUDE=U                                                                      
@ENDIF                                                                          
@REM *----------------------------------------------------------------          
@REM #RJICPY2 @SECTION=01 GENS AN INDD CARD AND AN OUTDD CARD PER PDS           
@REM *----------------------------------------------------------------          
@SECTION=03   <=======================================================          
@IF &ANY2COPY                                                                   
//SYSIN    DD   *                                                               
@ENDIF                                                                          
@REM *----------------------------------------------------------------          
@REM #RJICPY2 @SECTION=02 GENS AN IEBCOPY "COPY" STATEMENT PER PDS              
@REM *----------------------------------------------------------------          
@SECTION=04   <=======================================================          
//*                                                                             
@IF &ANY2DELETE                                                                 
//*#####################################################################        
//*                                                                             
//* DELETE STAGING DATS SETS                                                    
//*                                                                             
//*#####################################################################        
//JS02     EXEC PGM=IDCAMS,COND=(0,NE)                     #RJICPY1             
//SYSPRINT DD   SYSOUT=*                                                        
@ENDIF                                                                          
@SECTION=05   <=======================================================          
@IF &ANY2DELETE                                                                 
//SYSIN    DD   *                                                               
@ENDIF                                                                          
@REM *----------------------------------------------------------------          
@REM #RJICPY4 @SECTION=04 GENS A DD CARD PER PDS                                
@REM *----------------------------------------------------------------          
@SECTION=06   <=======================================================          
@IF &RUCD                                                                       
//*                                                                             
//***********************************************************                   
//* (OPTIONAL) MODIFY ARUCD COMMAND FILE          #RJICPY1                      
//*                                                                             
//* IF REQUIRED, YOU CAN EDIT THIS MODEL JCL HERE TO INSERT                     
//* A STEP TO MODIFY THE ARUCD BPXBATCH COMMAND FILE BEFORE                     
//* IT IS PROCESSED BY BPXBATCH.                                                
//* THE SYMBOL RUCD CAN BE USED FOR THE INPUT TO THE                            
//* TAILORING STEP.                                                             
//* THE STDPARM DD STATEMENT IN THE BPXBATCH STEP THAT                          
//* FOLLOWS CAN BE USED AS A MODEL FOR INPUT TO THE                             
//* INSERTED STEP.                                                              
//*                                                                             
//***********************************************************                   
//*                                                                             
//BPXBAT   EXEC PGM=BPXBATCH           ICPY                                     
//STDOUT   DD   SYSOUT=*                                                        
//STDERR   DD   SYSOUT=*                                                        
//STDPARM  DD   DISP=SHR,                                                       
//         DSN=&RUCD                                                            
@ENDIF                                                                          
@SECTION=07   <=======================================================          
@INCLUDE=(A)                                                                    
@IF RDISP=DELETE                                                                
//*#####################################################################        
//*                                                                             
//* DELETE USS FILES                                                            
//*                                                                             
//*#####################################################################        
//JS03     EXEC PGM=IDCAMS,COND=(0,NE)                     #RJICPY1             
//SYSPRINT DD   SYSOUT=*                                                        
//SYSIN    DD   *                                                               
@ENDIF                                                                          
@REM *----------------------------------------------------------------          
@REM #RJICPY2 @SECTION=06 GENS AN IDCAMS "DELETE" STATEMENT FOR REMOTE          
@REM                      STAGING DATA SETS IF REMOTE DISP=DELETE               
@REM #RJICPY6 @SECTION=06 GENS AN IDCAMS "DELETE" STATEMENT FOR REMOTE          
@REM                      JOB DATA SET AND DSN CROSS REFERENCE DATASET          
@REM                      IF REMOTE DISP=DELETE                                 
@REM *----------------------------------------------------------------          
@SECTION=08   <=======================================================          
@IF &RUCD                                                                       
//*#####################################################################        
//*                                                                             
//* DELETE Expanded FILES from PAX                                              
//*                                                                             
//*#####################################################################        
//DELXPAND EXEC PGM=BPXBATCH,COND=(0,NE)                                        
//STDOUT   DD   SYSOUT=*                                                        
//STDERR   DD   SYSOUT=*                                                        
//STDPARM  DD *,SYMBOLS=JCLONLY                                                 
SH                                                                              
  mkdir=$(cat /tmp/&USER._D&DATE._T&TIME..&PKGID._ARPAX.txt |                   
       grep "mkdir");                                                           
  rmcmd=$(echo "$mkdir" | sed 's/mkdir/rm/');                                   
  rmcmd=$(echo "$rmcmd" | sed 's/-p/-r/');                                      
  eval "$rmcmd";                                                                
  rm /tmp/&USER._D&DATE._T&TIME..&PKGID._ARPAX.txt;                             
@ENDIF                                                                          
//*                                                                             
&RCONFJCL                                                                       
//* **** END OF JOBSTREAM **** *                                                
